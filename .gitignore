# Dependências
node_modules/

# Cache do Vite (redirecionado para evitar EROFS com node_modules via symlink)
.vite/

# Pasta de build do Astro (gerada ao rodar 'npm run build')
dist/

# Cache interno do Astro (gerado ao rodar 'npm run dev')
.astro/

# Variáveis de ambiente (caso use no futuro)
.env
.env.local
.env.*.local

# Logs de erro do npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db

# Arquivos de configuração de IDE (VS Code, etc)
.vscode/
*.code-workspace
*.swp
*.swo
*~

# Artefato de deploy (gerado pelo dono)
dist.tar.gz
