---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getEntry } from 'astro:content';

const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? '';
const siteConfig = (await getEntry("site", "configuracao-do-site"))!.data;
const footerData = (await getEntry("site", "rodape"))!.data;

interface Props { title: string; description?: string; }
const { title, description = siteConfig.meta.descriptionDefault } = Astro.props;

const siteUrl = siteConfig.siteUrl;
const whatsappLink = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(siteConfig.whatsapp.mensagemAgendar)}`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': siteConfig.schemaOrg['@type'],
  '@id': `${siteUrl}/#org`,
  name: siteConfig.institucional.nomeFantasia,
  legalName: siteConfig.schemaOrg.legalName,
  url: siteUrl,
  email: siteConfig.contato.email,
  telephone: siteConfig.contato.telefone,
  identifier: siteConfig.contato.cnpj,
  description: siteConfig.schemaOrg.description,
  address: { '@type': 'PostalAddress', addressLocality: siteConfig.schemaOrg.addressLocality, addressRegion: siteConfig.schemaOrg.addressRegion, postalCode: siteConfig.schemaOrg.postalCode, addressCountry: siteConfig.schemaOrg.addressCountry },
  areaServed: siteConfig.schemaOrg.areaServed,
  knowsAbout: siteConfig.schemaOrg.knowsAbout
};

const colNavegacao = footerData.colunas.find((c) => c.titulo === 'Navegação');
const colContato = footerData.colunas.find((c) => c.titulo === 'Contato');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/castillo-symbol.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0F2A3E" />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/images/og-castillo.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-castillo.png`} />
    <link rel="alternate" hreflang="pt-br" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    {GA4_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>}
    {GA4_ID && <script is:inline define:vars={{ GA4_ID }}>window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',GA4_ID);</script>}
    {GA4_ID && <script is:inline>document.addEventListener('click',function(e){var t=e.target,el=t&&t.closest?t.closest('a'):null;if(!el||typeof gtag!=='function')return;var h=el.getAttribute('href')||'';if(h.indexOf('wa.me')!==-1){gtag('event','whatsapp_click',{event_category:'contato',event_label:el.textContent.trim().slice(0,40)})}else if(h==='#contato'){gtag('event','cta_click',{event_category:'contato',event_label:el.textContent.trim().slice(0,40)})}});</script>}
    <title>{title}</title>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">{siteConfig.a11y.skipLink}</a>

    <header class="header">
      <div class="header-inner">
        <a class="header-logo" href="/" aria-label={siteConfig.header.logoAria}>
          <img src="/images/castillo-logo-horizontal-negative.svg" alt={siteConfig.header.logoAlt} />
        </a>
        <div class="header-actions">
          <a class="header-wa" href={whatsappLink} target="_blank" rel="noopener noreferrer" aria-label={siteConfig.header.ctaWhatsAppMobileAria}>{siteConfig.header.ctaWhatsAppMobile}</a>
          <a class="header-cta" href="/#contato"><span class="txt-curto">{siteConfig.header.ctaPrincipalMobile}</span><span class="txt-longo">{siteConfig.header.ctaPrincipalDesktop}</span></a>
        </div>
      </div>
    </header>

    <main id="conteudo"><slot /></main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-cta">
          <h2>{footerData.cta.titulo}</h2>
          <p>{footerData.cta.texto}</p>
          <a href={footerData.cta.href} class="btn" data-tipo="primario">{footerData.cta.label}</a>
        </div>
        <div class="footer-cols">
          <div><h3>{footerData.colunas[0].titulo}</h3>{footerData.colunas[0].paragrafos.map((p) => <p>{p}</p>)}</div>
          <div><h3>{colNavegacao.titulo}</h3><ul>{colNavegacao.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>
          <div>
            <h3>{colContato.titulo}</h3>
            <ul>{colContato.itens.map((item) => {
              if (item.item) return <li>{item.item}</li>;
              if (item.tipo === 'email') return <li><a href={`mailto:${siteConfig.contato.email}`}>{item.label}</a></li>;
              if (item.tipo === 'whatsapp') return <li><a href={`https://wa.me/${siteConfig.whatsapp.number}`} target="_blank" rel="noopener noreferrer">{item.label}</a></li>;
              return <li>{item.label}</li>;
            })}</ul>
          </div>
        </div>
        <div class="footer-copy"><p>{footerData.copyright}</p></div>
      </div>
    </footer>

    <WhatsAppButton />
  </body>
</html>