---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Castillo Engineering - Diagnóstico Energético e Otimização de Sistemas' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/logo-padrao.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Castillo Engineering</title>
  </head>
  <body class="bg-castillo-white flex flex-col min-h-screen">
    
  <!-- HEADER -->
  <header class="bg-castillo-blue text-castillo-white sticky top-0 z-40 shadow-md">
    <div class="container mx-auto px-4 py-3">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center">
          <img 
            src="/images/castillo-logo_horizontal-negativo.svg" 
            alt="Castillo Engineering" 
            class="h-8 md:h-10 lg:h-12 w-auto object-contain"
          />
        </a>
        
        <!-- Navegação Desktop -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/" class="hover:text-castillo-orange transition-colors font-medium">Home</a>
          <a href="/servicos" class="hover:text-castillo-orange transition-colors font-medium">Serviços</a>
          <a href="/projetos" class="hover:text-castillo-orange transition-colors font-medium">Projetos</a>
          <a href="/sobre" class="hover:text-castillo-orange transition-colors font-medium">Sobre</a>
          <a 
            href="/contato" 
            class="bg-castillo-orange text-castillo-white px-5 py-2.5 rounded-lg font-bold hover:opacity-90 transition-opacity"
          >
            Contato
          </a>
        </nav>
        
        <!-- Botão Menu Mobile -->
        <button 
          id="mobile-menu-btn" 
          class="md:hidden text-castillo-white p-2 focus:outline-none"
          aria-label="Abrir menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      
      <!-- Menu Mobile (Escondido por padrão) -->
      <nav 
        id="mobile-menu" 
        class="hidden md:hidden mt-4 pb-4 border-t border-castillo-gray pt-4"
      >
        <div class="flex flex-col gap-4">
          <a href="/" class="hover:text-castillo-orange transition-colors font-medium">Home</a>
          <a href="/servicos" class="hover:text-castillo-orange transition-colors font-medium">Serviços</a>
          <a href="/projetos" class="hover:text-castillo-orange transition-colors font-medium">Projetos</a>
          <a href="/sobre" class="hover:text-castillo-orange transition-colors font-medium">Sobre</a>
          <a 
            href="/contato" 
            class="bg-castillo-orange text-castillo-white px-5 py-2.5 rounded-lg font-bold hover:opacity-90 transition-opacity text-center"
          >
            Contato
          </a>
        </div>
      </nav>
    </div>
    
    <!-- JavaScript para Menu Mobile -->
    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
    </script>
  </header>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-castillo-blue text-castillo-white mt-auto">
      <div class="container mx-auto px-4 py-8">
        <!-- CTA Final -->
        <div class="text-center mb-8 pb-8 border-b border-castillo-gray">
          <h2 class="text-2xl font-bold mb-4">Pronto para identificar o desperdício na sua planta?</h2>
          <p class="text-castillo-gray mb-6">Agende uma conversa técnica inicial sem compromisso.</p>
          <a 
            href="https://wa.me/5541985367273?text=Olá,%20vim%20pelo%20site%20e%20gostaria%20de%20saber%20mais%20sobre%20o%20Diagnóstico%20Energético"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-castillo-orange text-castillo-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity inline-block"
          >
            Falar com o Engenheiro no WhatsApp
          </a>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Coluna 1: Sobre -->
          <div>
            <h3 class="text-lg font-bold mb-4">Castillo Engineering LTDA</h3>
            <p class="text-castillo-gray text-sm">
              Soluções em Engenharia Térmica, CFD e Eficiência Energética.
            </p>
          </div>
          
          <!-- Coluna 2: Links -->
          <div>
            <h3 class="text-lg font-bold mb-4">Links Rápidos</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/servicos" class="text-castillo-gray hover:text-castillo-orange">Serviços</a></li>
              <li><a href="/projetos" class="text-castillo-gray hover:text-castillo-orange">Projetos</a></li>
              <li><a href="/sobre" class="text-castillo-gray hover:text-castillo-orange">Sobre</a></li>
              <li><a href="/contato" class="text-castillo-gray hover:text-castillo-orange">Contato</a></li>
            </ul>
          </div>
          
          <!-- Coluna 3: Contato (Minimalista - Sem Endereço Residencial) -->
          <div>
            <h3 class="text-lg font-bold mb-4">Contato</h3>
            <ul class="space-y-2 text-sm text-castillo-gray">
              <li>Curitiba/PR - Brasil</li>
              <li>Atendimento em todo Brasil e América do Sul</li>
              <li>fernando@castilloeng.com.br</li>
              <li>(41) 98536-7273</li>
            </ul>
          </div>
        </div>
        
        <!-- Copyright + Nota Legal -->
        <div class="border-t border-castillo-gray mt-8 pt-8 text-center text-sm text-castillo-gray">
          <p>&copy; 2026 Castillo Engineering LTDA. Todos os direitos reservados.</p>
          <p class="mt-2 text-xs">Engenheiro Mecânico - CREA-PR Ativo | CNPJ: XX.XXX.XXX/0001-XX</p>
        </div>
      </div>
    </footer>

    <!-- WHATSAPP BUTTON (Flutuante - Sempre Visível) -->
    <WhatsAppButton />

  </body>
</html>