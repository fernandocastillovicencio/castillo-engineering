---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
}

// SEO otimizado com base no DPE
const { 
  title, 
  description = 'Diagnóstico termodinâmico industrial sem CAPEX. Reduza o custo de energia térmica usando dados que sua planta já coleta. Castillo Engineering - Curitiba, PR.' 
} = Astro.props;

// Link do WhatsApp padronizado (vai ser usado no menu e no footer)
const whatsappLink = "https://wa.me/5541985367273?text=Olá,%20vim%20pelo%20site%20e%20gostaria%20de%20solicitar%20um%20Diagnóstico%20Preliminar%20Sem%20Custo";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Corrigido: apontando para o SVG real que existe na sua pasta -->
    <link rel="icon" type="image/svg+xml" href="/images/castillo-logo_horizontal-negativo.svg" />
    
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    
    <!-- SEO: Título dinâmico melhorado -->
    <title>{title} | Castillo Engineering</title>
  </head>
  
  <body class="bg-castillo-white flex flex-col min-h-screen">
    
    <!-- HEADER SIMPLIFICADO (Single Page) -->
    <header class="bg-castillo-blue text-castillo-white sticky top-0 z-40 shadow-md">
      <div class="container mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <a href="/" class="flex items-center">
            <img 
              src="/images/castillo-logo_horizontal-negativo.svg" 
              alt="Castillo Engineering - Diagnóstico Termodinâmico" 
              class="h-8 md:h-10 lg:h-12 w-auto object-contain"
            />
          </a>
          
          <!-- Único CTA do Menu (Desktop e Mobile) -->
          <!-- Removido: Menu Hambúrguer e links de navegação interna -->
          <a 
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-castillo-orange text-castillo-white px-5 py-2.5 rounded-lg font-bold hover:opacity-90 transition-opacity text-sm md:text-base"
          >
            Solicitar Diagnóstico
          </a>
        </div>
      </div>
    </header>

    <!-- CONTEÚDO PRINCIPAL (Onde o index.astro vai renderizar) -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- FOOTER REESTRUTURADO (Foco institucional e correto) -->
    <footer class="bg-castillo-blue text-castillo-white mt-auto">
      <div class="container mx-auto px-4 py-8">
        
        <!-- CTA Final do Footer -->
        <div class="text-center mb-8 pb-8 border-b border-castillo-gray">
          <h2 class="text-2xl font-bold mb-4">Pronto para identificar o desperdício térmico na sua operação?</h2>
          <p class="text-castillo-gray mb-6">Converse sem compromisso com um engenheiro especialista.</p>
          <a 
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-castillo-orange text-castillo-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity inline-block"
          >
            Falar no WhatsApp
          </a>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Coluna 1: Sobre (Alinhado ao DPE) -->
          <div>
            <h3 class="text-lg font-bold mb-4">Castillo Engineering LTDA</h3>
            <p class="text-castillo-gray text-sm">
              Consultoria especializada em eficiência térmica industrial. 
              Diagnóstico a partir de dados que o cliente já possui, sem exigir investimentos adicionais.
            </p>
          </div>
          
          <!-- Coluna 2: Responsabilidade Técnica (Credibilidade) -->
          <div>
            <h3 class="text-lg font-bold mb-4">Responsabilidade Técnica</h3>
            <ul class="space-y-2 text-sm text-castillo-gray">
              <li>Engenheiro Mecânico — CREA-PR Ativo</li>
              <li>Atribuições plenas (Art. 12, Res. CONFEA 218/73)</li>
              <li>Laudos com ART e NDA padrão</li>
              <li>Método baseado em normas (ABNT, ASME)</li>
            </ul>
          </div>
          
          <!-- Coluna 3: Contato (Corrigido) -->
          <div>
            <h3 class="text-lg font-bold mb-4">Contato</h3>
            <ul class="space-y-2 text-sm text-castillo-gray">
              <li>Curitiba/PR — Brasil</li>
              <li>Foco: Indústria de Alimentos e Bebidas (RMC)</li>
              <!-- Corrigido: E-mail real -->
              <li>contato@castilloeng.com.br</li>
              <li>(41) 98536-7273</li>
            </ul>
          </div>
        </div>
        
        <!-- Copyright -->
        <div class="border-t border-castillo-gray mt-8 pt-8 text-center text-sm text-castillo-gray">
          <p>&copy; 2026 Castillo Engineering LTDA. Todos os direitos reservados.</p>
        </div>
      </div>
    </footer>

    <!-- WHATSAPP BUTTON (Flutuante) -->
    <WhatsAppButton />

  </body>
</html>