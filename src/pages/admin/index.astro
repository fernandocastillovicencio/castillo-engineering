---
// Decap CMS admin panel — served at /admin/.
// This is a pure HTML page; Astro must NOT process the script tag.
// is:inline prevents bundling, keeps the CDN <script> as-is.
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Conteúdo — Castillo Engenharia</title>
    <!-- CMS carregado apenas nesta página de administração.
         O site público NÃO inclui estes arquivos (peso zero nas páginas). -->
    <link href="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.css" rel="stylesheet" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>