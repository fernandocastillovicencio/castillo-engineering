---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { DATE_LOCALE, ui } from '../../../i18n';

const t = ui.es;
const posts = (await getCollection('articles'))
  .filter((post) => post.id.startsWith('es/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const slug = (id: string) => id.replace(/^es\//, '');
const dataFmt = (d) =>
  d.toLocaleDateString(DATE_LOCALE.es, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title={t.articlesListTitle}
  description={t.articlesListDescription}
  lang="es"
  altUrl="/articles"
  showSwitch={false}
>
  <section id="articles">
    <div class="container-site">
      <h1>{t.articlesListHeading}</h1>
      <p class="intro-lista">{t.articlesListIntro}</p>
      <div class="articles-list">
        {posts.map((post) => (
          <article class="card-article">
            <a href={`/es/articles/${slug(post.id)}`} class="card-article-link" aria-label={`${post.data.title} — ${t.readArticleAria}`}>
              {post.data.capa && (
                <img src={post.data.capa} alt="" decoding="async" width="1600" height="900" />
              )}
              <div class="card-article-body">
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {dataFmt(post.data.date)}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.resumo}</p>
                <span class="link-cta">{t.readArticle}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
