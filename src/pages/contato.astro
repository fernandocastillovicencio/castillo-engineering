---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contato" 
  description="Entre em contato com a Castillo Engineering para orçamento de projetos em CFD, eficiência energética e engenharia térmica"
>
  
  <!-- Hero Section -->
  <section class="bg-castillo-blue text-castillo-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Entre em Contato
      </h1>
      <p class="text-xl text-castillo-gray max-w-2xl mx-auto">
        Solicite um orçamento ou tire suas dúvidas sobre nossos serviços 
        em engenharia térmica e simulação computacional.
      </p>
    </div>
  </section>

  <!-- Formulário e Informações -->
  <section class="py-16 bg-castillo-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid md:grid-cols-2 gap-12">
        
        <!-- Formulário -->
        <div>
          <h2 class="text-2xl font-bold text-castillo-blue mb-6">
            Envie uma Mensagem
          </h2>
          <form class="space-y-6">
            <div>
              <label for="nome" class="block text-castillo-blue font-semibold mb-2">
                Nome Completo *
              </label>
              <input 
                type="text" 
                id="nome" 
                name="nome" 
                required
                class="w-full px-4 py-3 border-2 border-castillo-gray rounded-lg focus:border-castillo-blue focus:outline-none transition-colors"
                placeholder="Seu nome"
              />
            </div>
            <div>
              <label for="email" class="block text-castillo-blue font-semibold mb-2">
                E-mail *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 border-2 border-castillo-gray rounded-lg focus:border-castillo-blue focus:outline-none transition-colors"
                placeholder="seu@email.com"
              />
            </div>
            <div>
              <label for="empresa" class="block text-castillo-blue font-semibold mb-2">
                Empresa
              </label>
              <input 
                type="text" 
                id="empresa" 
                name="empresa" 
                class="w-full px-4 py-3 border-2 border-castillo-gray rounded-lg focus:border-castillo-blue focus:outline-none transition-colors"
                placeholder="Nome da sua empresa"
              />
            </div>
            <div>
              <label for="assunto" class="block text-castillo-blue font-semibold mb-2">
                Assunto *
              </label>
              <select 
                id="assunto" 
                name="assunto" 
                required
                class="w-full px-4 py-3 border-2 border-castillo-gray rounded-lg focus:border-castillo-blue focus:outline-none transition-colors"
              >
                <option value="">Selecione um assunto</option>
                <option value="orcamento">Solicitar Orçamento</option>
                <option value="cfd">CFD & Simulação Computacional</option>
                <option value="eficiencia">Eficiência Energética</option>
                <option value="hvac">HVAC & Climatização</option>
                <option value="treinamento">Treinamento/Capacitação</option>
                <option value="outro">Outro</option>
              </select>
            </div>
            <div>
              <label for="mensagem" class="block text-castillo-blue font-semibold mb-2">
                Mensagem *
              </label>
              <textarea 
                id="mensagem" 
                name="mensagem" 
                required
                rows="5"
                class="w-full px-4 py-3 border-2 border-castillo-gray rounded-lg focus:border-castillo-blue focus:outline-none transition-colors"
                placeholder="Descreva seu projeto ou dúvida..."
              ></textarea>
            </div>
            <button 
              type="submit"
              class="bg-castillo-orange text-castillo-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity w-full"
            >
              Enviar Mensagem
            </button>
          </form>
        </div>

        <!-- Informações de Contato -->
        <div>
          <h2 class="text-2xl font-bold text-castillo-blue mb-6">
            Informações de Contato
          </h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="text-2xl">📍</div>
              <div>
                <h3 class="font-bold text-castillo-blue">Localização</h3>
                <p class="text-castillo-gray">Curitiba/PR - Brasil</p>
                <p class="text-castillo-gray text-sm">Atendimento presencial e remoto</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="text-2xl">📧</div>
              <div>
                <h3 class="font-bold text-castillo-blue">E-mail</h3>
                <p class="text-castillo-gray">contato@castilloengineering.com.br</p>
                <p class="text-castillo-gray text-sm">Resposta em até 24h úteis</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="text-2xl">💼</div>
              <div>
                <h3 class="font-bold text-castillo-blue">Horário de Atendimento</h3>
                <p class="text-castillo-gray">Segunda a Sexta</p>
                <p class="text-castillo-gray text-sm">8:00 às 18:00 (BRT)</p>
              </div>
            </div>
          </div>

          <!-- Redes Sociais (placeholder) -->
          <div class="mt-8">
            <h3 class="font-bold text-castillo-blue mb-4">Redes Sociais</h3>
            <div class="flex gap-4">
              <a href="#" class="bg-castillo-blue text-castillo-white px-4 py-2 rounded-lg hover:opacity-90 transition-opacity text-sm">
                LinkedIn
              </a>
              <a href="#" class="bg-castillo-blue text-castillo-white px-4 py-2 rounded-lg hover:opacity-90 transition-opacity text-sm">
                GitHub
              </a>
            </div>
          </div>

          <!-- Nota sobre orçamento -->
          <div class="mt-8 bg-castillo-gray bg-opacity-20 rounded-lg p-6">
            <h3 class="font-bold text-castillo-blue mb-2">💡 Dica para Orçamentos</h3>
            <p class="text-castillo-gray text-sm">
              Para orçamentos mais precisos, inclua informações sobre:
            </p>
            <ul class="text-castillo-gray text-sm mt-2 space-y-1">
              <li>• Tipo de sistema ou equipamento</li>
              <li>• Objetivos do projeto</li>
              <li>• Prazo desejado</li>
              <li>• Dados técnicos disponíveis</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Mapa (placeholder) -->
  <section class="py-16 bg-castillo-gray bg-opacity-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-castillo-blue mb-6">
        Atendemos em Todo o Brasil
      </h2>
      <p class="text-xl text-castillo-gray max-w-2xl mx-auto">
        Embora estejemos baseados em Curitiba/PR, atendemos clientes 
        em todo o território nacional de forma remota e presencial.
      </p>
    </div>
  </section>

</Layout>