---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const notFound = (await getEntry('site', 'pagina-nao-encontrada'))!.data;
const siteConfig = (await getEntry("site", "configuracao-do-site"))!.data;
const dados = notFound;
const whatsapp404 = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(siteConfig.whatsapp.mensagem404)}`;
---

<Layout title={dados.seo.title} description={dados.seo.description}>
  <section id="nao-encontrada" class="container-site">
    <h1>{dados.codigo}</h1>
    <p class="lead">{dados.textoPrincipal}</p>
    <p class="card-body">{dados.textoDetalhe}</p>
    <div class="ctas">{dados.ctas.map((cta) => (
      cta.estilo === 'primario' ? <a href={cta.href} class="btn" data-tipo="primario">{cta.label}</a>
      : <a href={cta.href === 'whatsapp404' ? whatsapp404 : cta.href} target="_blank" rel="noopener noreferrer" class="btn" data-tipo="contorno">{cta.label}</a>
    ))}</div>
  </section>
</Layout>