---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const privacy = await getEntry('site', 'pagina-privacidade-lgpd');
const { Content } = await render(privacy);
const dados = privacy.data;
---

<Layout title={dados.seo.title} description={dados.seo.description}>
  <section id="privacidade">
    <div class="container-site">
      <h1>{dados.h1}</h1>
      <div class="corpo">
        <Content />
        <p class="atualizado">{dados.ultimaAtualizacao}</p>
      </div>
    </div>
  </section>
</Layout>