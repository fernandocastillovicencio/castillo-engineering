---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
// Ordenar por data (mais recente primeiro)
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout 
  title="Blog" 
  description="Artigos técnicos sobre CFD, eficiência energética, HVAC e engenharia térmica"
>
  
  <!-- Hero Section -->
  <section class="bg-castillo-blue text-castillo-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Blog Técnico
      </h1>
      <p class="text-xl text-castillo-gray max-w-2xl mx-auto">
        Artigos e insights sobre engenharia térmica, simulação computacional 
        e eficiência energética.
      </p>
    </div>
  </section>

  <!-- Lista de Posts -->
  <section class="py-16 bg-castillo-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-castillo-white border-2 border-castillo-blue rounded-lg p-6 hover:shadow-lg transition-shadow flex flex-col">
            <div class="mb-4">
              {post.data.tags && post.data.tags.slice(0, 3).map((tag) => (
                <span class="bg-castillo-gray bg-opacity-20 text-castillo-blue px-3 py-1 rounded-lg text-xs font-semibold mr-2">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-xl font-bold text-castillo-blue mb-3">
              {post.data.title}
            </h3>
            <p class="text-castillo-gray mb-4 flex-grow">
              {post.data.description}
            </p>
            <div class="text-sm text-castillo-gray mb-4">
              <span>{new Date(post.data.date).toLocaleDateString('pt-BR')}</span>
              {post.data.author && (
                <span className="ml-2">• {post.data.author}</span>
              )}
            </div>
            <a 
              href={`/blog/${post.slug}`}
              class="text-castillo-orange font-bold hover:underline inline-flex items-center"
            >
              Ler mais
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-castillo-gray bg-opacity-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-castillo-blue mb-6">
        Quer Receber Conteúdo Exclusivo?
      </h2>
      <p class="text-xl text-castillo-gray mb-8 max-w-2xl mx-auto">
        Entre em contato e saiba mais sobre nossos serviços e publicações técnicas.
      </p>
      <a 
        href="/contato" 
        class="bg-castillo-orange text-castillo-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity inline-block"
      >
        Fale Conosco
      </a>
    </div>
  </section>

</Layout>