---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projetos = await getCollection('projetos');
// Ordenar por ordem definida no frontmatter
projetos.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
---

<Layout 
  title="Projetos" 
  description="Cases de sucesso em CFD, eficiência energética e engenharia térmica"
>
  
  <!-- Hero Section -->
  <section class="bg-castillo-blue text-castillo-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Projetos e Cases
      </h1>
      <p class="text-xl text-castillo-gray max-w-2xl mx-auto">
        Conheça alguns dos projetos realizados pela Castillo Engineering 
        em diversos setores da indústria.
      </p>
    </div>
  </section>

  <!-- Lista de Projetos -->
  <section class="py-16 bg-castillo-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        {projetos.map((projeto) => (
          <div class="bg-castillo-white border-2 border-castillo-blue rounded-lg p-6 hover:shadow-lg transition-shadow flex flex-col">
            <div class="mb-4">
              <span class="bg-castillo-gray bg-opacity-20 text-castillo-blue px-3 py-1 rounded-lg text-sm font-semibold">
                {projeto.data.area}
              </span>
            </div>
            <h3 class="text-xl font-bold text-castillo-blue mb-3">
              {projeto.data.title}
            </h3>
            {projeto.data.cliente && (
              <p class="text-castillo-gray mb-2">
                <span class="font-semibold">Cliente:</span> {projeto.data.cliente}
              </p>
            )}
            <p class="text-castillo-gray mb-4 flex-grow">
              {projeto.data.description}
            </p>
            {projeto.data.resultado && (
              <div class="bg-castillo-orange bg-opacity-10 border-l-4 border-castillo-orange p-4 mb-4">
                <p class="text-castillo-blue font-bold">Resultado:</p>
                <p class="text-castillo-gray text-sm">{projeto.data.resultado}</p>
              </div>
            )}
            {projeto.data.software && (
              <div class="mb-4">
                <span class="text-sm font-semibold text-castillo-blue">Software:</span>
                <span class="text-sm text-castillo-gray ml-2">
                  {projeto.data.software.join(', ')}
                </span>
              </div>
            )}
            <a 
              href={`/projetos/${projeto.slug}`}
              class="text-castillo-orange font-bold hover:underline inline-flex items-center"
            >
              Ver detalhes
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-castillo-gray bg-opacity-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-castillo-blue mb-6">
        Quer Ver Seu Projeto Aqui?
      </h2>
      <p class="text-xl text-castillo-gray mb-8 max-w-2xl mx-auto">
        Entre em contato e descubra como podemos ajudar sua empresa 
        a alcançar resultados semelhantes.
      </p>
      <a 
        href="/contato" 
        class="bg-castillo-orange text-castillo-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity inline-block"
      >
        Solicitar Orçamento
      </a>
    </div>
  </section>

</Layout>