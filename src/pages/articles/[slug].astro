---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Article from '../../components/Article.astro';

// Sem a versão espanhola na coleção, nenhum artigo em /es/ entra aqui.
const todos = await getCollection('articles');
const slugsEs = new Set(
  todos.filter((post) => post.id.startsWith('es/')).map((post) => post.id.replace(/^es\//, ''))
);

export async function getStaticPaths() {
  const posts = (await getCollection('articles')).filter((post) => !post.id.startsWith('es/'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const dados = post.data;
const altUrl = slugsEs.has(post.id) ? `/es/articles/${post.id}` : undefined;
---

<Layout
  title={`${dados.seo?.title ?? dados.title} — Castillo Engenharia`}
  description={dados.seo?.description ?? dados.resumo}
  ogType="article"
  ogImage={dados.og}
  lang="pt"
  altUrl={altUrl}
>
  <Article post={post} slug={post.id} lang="pt" altUrl={altUrl} />
</Layout>
