---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const servicos = await getCollection('servicos');
// Ordenar por ordem definida no frontmatter
servicos.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
---

<Layout 
  title="Serviços" 
  description="CFD, Eficiência Energética, HVAC, Bombeamento e mais soluções em engenharia térmica"
>
  
  <!-- Hero Section -->
  <section class="bg-castillo-blue text-castillo-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Nossos Serviços
      </h1>
      <p class="text-xl text-castillo-gray max-w-2xl mx-auto">
        Soluções completas em engenharia térmica, simulação computacional 
        e eficiência energética para indústrias e edificações.
      </p>
    </div>
  </section>

  <!-- Lista de Serviços -->
  <section class="py-16 bg-castillo-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {servicos.map((servico) => (
          <div class="bg-castillo-white border-2 border-castillo-blue rounded-lg p-6 hover:shadow-lg transition-shadow flex flex-col">
            <h3 class="text-xl font-bold text-castillo-blue mb-3">
              {servico.data.title}
            </h3>
            <p class="text-castillo-gray mb-4 flex-grow">
              {servico.data.description}
            </p>
            {servico.data.software && (
              <div class="mb-4">
                <span class="text-sm font-semibold text-castillo-blue">Software:</span>
                <span class="text-sm text-castillo-gray ml-2">
                  {servico.data.software.join(', ')}
                </span>
              </div>
            )}
            <a 
              href={`/servicos/${servico.slug}`}
              class="text-castillo-orange font-bold hover:underline inline-flex items-center"
            >
              Saiba mais
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-castillo-gray bg-opacity-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-castillo-blue mb-6">
        Precisa de um Serviço Personalizado?
      </h2>
      <p class="text-xl text-castillo-gray mb-8 max-w-2xl mx-auto">
        Entre em contato e discutimos como podemos ajudar sua empresa 
        com soluções sob medida.
      </p>
      <a 
        href="/contato" 
        class="bg-castillo-orange text-castillo-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity inline-block"
      >
        Solicitar Orçamento
      </a>
    </div>
  </section>

</Layout>
