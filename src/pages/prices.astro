---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const priceData = (await getEntry('site', 'pagina-investimento'))!.data;
const dados = priceData;
---

<Layout title={dados.seo.title} description={dados.seo.description}>
  <section id="precos">
    <div class="container-site">
      <h1 class="section-title">{dados.h1}</h1>
      <p>{dados.intro}</p>

      {dados.etapas.map((etapa) => (
        etapa.destaque ? (
          <div class="box-dark mb-6">
            <h2 class="card-title">{etapa.titulo}</h2>
            <p>{etapa.texto}{etapa.textoDestaque && <strong>{etapa.textoDestaque}</strong>}</p>
            {etapa.prazo && <p class="prazo"><strong>{dados.prazoLabel}</strong> {etapa.prazo}</p>}
          </div>
        ) : etapa.cards ? (
          <div class="card mb-8">
            <h2 class="card-title">{etapa.titulo}</h2>
            <ul class="item-grid">{etapa.cards.map((card) => <li><h3 class="card-title">{card.nome}</h3><p class="card-body">{card.texto}</p></li>)}</ul>
            {etapa.nota && <p class="card-body mt-6">{etapa.nota}</p>}
          </div>
        ) : (
          <div class="card mb-6">
            <h2 class="card-title">{etapa.titulo}</h2>
            <p class="card-body">{etapa.texto}</p>
          </div>
        )
      ))}

      <div class="card mb-8">
        <h2 class="card-title">{dados.comoPrecificamos.titulo}</h2>
        <div class="space-y-4">{dados.comoPrecificamos.pontos.map((ponto) => <p class="card-body"><strong>{ponto.destaque}</strong> {ponto.texto}</p>)}</div>
        <p class="card-body mt-4">{dados.comoPrecificamos.risco}</p>
      </div>

      <div class="cta-wrap"><a href={dados.cta.href} class="btn" data-tipo="primario">{dados.cta.label}</a></div>
    </div>
  </section>
</Layout>