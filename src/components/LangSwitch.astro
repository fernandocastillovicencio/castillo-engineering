---
/**
 * Seletor de idioma: duas bandeiras (Brasil / Espanha).
 * Clicar troca a língua da página equivalente (ou da home do outro idioma).
 *
 * Aparece em dois lugares, nunca duplicado no mesmo tamanho de tela:
 *   - cabeçalho, a partir de 1280 px (folga medida; de 1024 a 1279 não cabe)
 *   - primeira linha do hero (home) ou da trilha (artigo), abaixo de 1280 px
 *
 * O idioma atual é um <span>: um <a> sem href não é focável e some da árvore
 * de acessibilidade, deixando o leitor de tela sem saber em que idioma está.
 */
import Flag from './Flag.astro';
import { HTML_LANG, homeHref, otherLang, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** URL da mesma página no outro idioma. Sem ela, aponta para a home dele. */
  altUrl?: string;
  class?: string;
}
const { lang, altUrl, class: cls = '' } = Astro.props;
const destino = altUrl ?? homeHref(otherLang(lang));
const t = ui[lang]; // rótulos no idioma da página atual
const naPaginaEs = lang === 'es';

const itens = [
  { code: 'pt' as const, href: naPaginaEs ? destino : null, atual: t.langPtAtual, rotulo: t.langPt },
  { code: 'es' as const, href: naPaginaEs ? null : destino, atual: t.langEsAtual, rotulo: t.langEs },
];
---

<nav class={`lang-switch ${cls}`} aria-label={t.langSwitchAria}>
  {itens.map((item) =>
    item.href ? (
      <a
        class="lang-btn"
        href={item.href}
        hreflang={HTML_LANG[item.code]}
        lang={HTML_LANG[item.code]}
        title={item.rotulo}
        aria-label={item.rotulo}
      >
        <Flag code={item.code} />
      </a>
    ) : (
      <span class="lang-btn" aria-current="true" lang={HTML_LANG[item.code]}>
        <Flag code={item.code} />
        <span class="sr-only">{item.atual}</span>
      </span>
    )
  )}
</nav>
